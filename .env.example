# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenAI API key — required for the LLM, and for Moderation (input/output guardrails)
OPENAI_API_KEY=

# Brave Search API key — only required if ENABLE_WEB_SEARCH is true below
BRAVE_API_KEY=

# Off by default so a fresh checkout doesn't burn Brave Search credits.
# Set to true (and provide BRAVE_API_KEY above) to let Sarjy call brave_search.
ENABLE_WEB_SEARCH=false
